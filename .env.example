# Copie para frontend/.env.local e preencha. Nunca commite valores reais.
# Local: valores de `npx supabase status`. Produção: painel do Supabase (Project Settings → API).

# Supabase: usadas no navegador e no servidor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: só no servidor. SECRETA, nunca use o prefixo NEXT_PUBLIC_
SUPABASE_serviceRoleKey=

# Storage: bucket privado das fotos de perfil (criado por migration)
STORAGE_bucketFotos=fotos-perfil